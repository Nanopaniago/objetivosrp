# Primeiro administrador (só é criado quando a base de dados ainda não tem utilizadores)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troca-esta-palavra-passe
ADMIN_NAME=Nano

# Leitura de imagens (Google AI Studio → Get API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Pôr true quando o acesso for por HTTPS (ex.: Cloudflare Tunnel)
COOKIE_SECURE=true

# Fuso horário usado para "hoje"
TZ_REPORTS=Europe/Lisbon
